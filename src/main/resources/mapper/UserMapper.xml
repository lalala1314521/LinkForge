<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.project.mapper.UserMapper">
    <!--通用结果映射-->
    <resultMap id="UserResultMap" type="com.example.project.entity.User">
        <id     column="id"        property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname"   property="nickname"/>
        <result column="phone"      property="phone"/>
        <result column="email"      property="email"/>
        <result column="status"     property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!--动态条件分页查询-->
    <select id="selectByCondition" resultMap="UserResulMap">
        SELECT * FROM user
        <where>
            <if test="req.keyword != null and req.keyword != ''">
                AND (username LIKE CONCAT('%', #{req.keyword}, '%')
                    OR nickname LIKE CONCAT('%', #{req.keyword}, '%'))
            </if>
            <if test="req.status != null">
                AND status = #{req.status}
            </if>
            AND status = 'DELETED'
        </where>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!--动态条件统计计数-->
    <select id="countByCondition" resultMap="long">
        SELECT COUNT(1) FROM users
        <where>
            <if test="req.keyword != null and req.keyword != ''">
                AND (username LIKE CONCAT('%', #{req.keyword}, '%')
                   OR nickname LIKE CONCAT('%', #{req.keyword}, '%'))
            </if>
            <if test="req.status != null">
                AND status = #{req.status}
            </if>
            AND status != 'DELETE'
        </where>
    </select>

    <!--游标分页查询
        当 offset > 1000 时， 使用 WHERE id < lastId ORDER BY id DESC LIMIT size 替代OFFSET
        首次查询传lastId = 0, 后续传上一页最后一条记录的id
     -->
    <select id="selectByCursor" resultMap="UserResultMap">
        SELECT * FROM users
        WHERE status != 'DELETED'
        <if test="lastId != null and lastId > 0">
            AND id &lt; #{lastId}
        </if>
        ORDER BY id DESC
        LIMIT #{size}
    </select>

</mapper>
